{
  "name": "private-ai",
  "version": "1.0.77",
  "description": "Chat with your notes using a local AI model. Private by design: your notes never leave your device.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "privacy:scan": "node scripts/privacy-scan.mjs",
    "test:watch": "vitest",
    "eval": "wdio run e2e/wdio.conf.mts",
    "eval:offline": "E2E_OFFLINE=1 wdio run e2e/wdio.conf.mts",
    "eval:live": "wdio run e2e/wdio.live.conf.mts",
    "version": "node version-bump.mjs",
    "release": "npm run build && node version-bump.mjs",
    "screenshots": "wdio run e2e/wdio.readme.conf.mts"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "local-llm",
    "chat",
    "ai",
    "private"
  ],
  "author": "GB",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabosgab/ObsidianPrivateAI.git"
  },
  "bugs": {
    "url": "https://github.com/gabosgab/ObsidianPrivateAI/issues"
  },
  "homepage": "https://github.com/gabosgab/ObsidianPrivateAI#readme",
  "dependencies": {
    "@mariozechner/pi-agent-core": "^0.73.1",
    "@mariozechner/pi-ai": "^0.73.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "typebox": "^1.4.7"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@wdio/cli": "^10.2.0",
    "@wdio/globals": "^10.2.0",
    "@wdio/local-runner": "^10.2.0",
    "@wdio/mocha-framework": "^10.2.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "mocha": "^12.0.3",
    "obsidian": "^1.14.4",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "vitest": "^5.1.1",
    "wdio-obsidian-reporter": "^3.5.0",
    "wdio-obsidian-service": "^3.5.0"
  },
  "overrides": {
    "proxy-agent": "^8.0.3",
    "pac-proxy-agent": "^9.1.1",
    "get-uri": "^8.0.2",
    "basic-ftp": "^6.2.6",
    "glob": "^14.0.6",
    "minimatch": "^11.0.9",
    "readdir-glob": "^4.0.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}